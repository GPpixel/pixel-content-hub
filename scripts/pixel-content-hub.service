[Unit]
Description=Pixel Content Hub (digital signage server)
After=network.target
Wants=network-online.target

[Service]
Type=simple
# For the checkout at ~/pixel-content-hub and Node 22 from nvm in ~/.config/nvm
# (docs/pixel-install.md). Replace each youruser with your Linux user name.
User=youruser
WorkingDirectory=/home/youruser/pixel-content-hub/server
# npm start loads server/.env (PORT=2004 and the rest), so settings stay in one place.
ExecStart=/bin/bash -c 'source /home/youruser/.config/nvm/nvm.sh && exec npm start'
Restart=always
RestartSec=5
# 78 = the server refused to start because Node is below 22.14. Restarting can't fix that.
RestartPreventExitStatus=78
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pixel-content-hub

[Install]
WantedBy=multi-user.target
